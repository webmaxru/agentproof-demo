{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproof.dev/schemas/release-policy-v1.schema.json",
  "title": "AgentProof release policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "path", "rules", "exceptions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "path": { "$ref": "#/$defs/relativePath" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "dependencies", "dataRetention", "provenance"],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["suite", "requiredTests", "coverage"],
          "properties": {
            "suite": { "$ref": "#/$defs/findingRule" },
            "requiredTests": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "findingId",
                  "testId",
                  "title",
                  "severity",
                  "exceptionable",
                  "remediationHint"
                ],
                "properties": {
                  "findingId": { "$ref": "#/$defs/findingId" },
                  "testId": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9][a-z0-9._:-]+$"
                  },
                  "title": { "$ref": "#/$defs/title" },
                  "severity": { "$ref": "#/$defs/severity" },
                  "exceptionable": { "type": "boolean" },
                  "remediationHint": { "$ref": "#/$defs/remediationHint" }
                }
              }
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "findingId",
                "title",
                "severity",
                "exceptionable",
                "remediationHint",
                "minimum"
              ],
              "properties": {
                "findingId": { "$ref": "#/$defs/findingId" },
                "title": { "$ref": "#/$defs/title" },
                "severity": { "$ref": "#/$defs/severity" },
                "exceptionable": { "type": "boolean" },
                "remediationHint": { "$ref": "#/$defs/remediationHint" },
                "minimum": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lines", "functions", "branches", "statements"],
                  "properties": {
                    "lines": { "$ref": "#/$defs/percentage" },
                    "functions": { "$ref": "#/$defs/percentage" },
                    "branches": { "$ref": "#/$defs/percentage" },
                    "statements": { "$ref": "#/$defs/percentage" }
                  }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findingId",
            "title",
            "severity",
            "exceptionable",
            "remediationHint",
            "maximumAllowedSeverity"
          ],
          "properties": {
            "findingId": { "$ref": "#/$defs/findingId" },
            "title": { "$ref": "#/$defs/title" },
            "severity": { "$ref": "#/$defs/severity" },
            "exceptionable": { "type": "boolean" },
            "remediationHint": { "$ref": "#/$defs/remediationHint" },
            "maximumAllowedSeverity": { "$ref": "#/$defs/severity" }
          }
        },
        "dataRetention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findingId",
            "title",
            "severity",
            "exceptionable",
            "remediationHint",
            "requiredFields",
            "maximumDays"
          ],
          "properties": {
            "findingId": { "$ref": "#/$defs/findingId" },
            "title": { "$ref": "#/$defs/title" },
            "severity": { "$ref": "#/$defs/severity" },
            "exceptionable": { "type": "boolean" },
            "remediationHint": { "$ref": "#/$defs/remediationHint" },
            "requiredFields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              }
            },
            "maximumDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findingId",
            "title",
            "severity",
            "exceptionable",
            "remediationHint",
            "requireDeclaration"
          ],
          "properties": {
            "findingId": { "$ref": "#/$defs/findingId" },
            "title": { "$ref": "#/$defs/title" },
            "severity": { "$ref": "#/$defs/severity" },
            "exceptionable": { "type": "boolean" },
            "remediationHint": { "$ref": "#/$defs/remediationHint" },
            "requireDeclaration": { "type": "boolean" }
          }
        }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedMinimumPermission",
        "minimumRationaleLength",
        "maximumDurationDays",
        "allowedFindingStates",
        "maximumSeverity"
      ],
      "properties": {
        "authorizedMinimumPermission": {
          "enum": ["none", "read", "triage", "write", "maintain", "admin"]
        },
        "minimumRationaleLength": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "maximumDurationDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "allowedFindingStates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["pass", "fail", "unknown", "exception"] }
        },
        "maximumSeverity": { "$ref": "#/$defs/severity" }
      }
    }
  },
  "$defs": {
    "findingId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80,
      "pattern": "^AP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "severity": {
      "enum": ["info", "low", "moderate", "high", "critical"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "remediationHint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "findingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "title", "severity", "exceptionable", "remediationHint"],
      "properties": {
        "findingId": { "$ref": "#/$defs/findingId" },
        "title": { "$ref": "#/$defs/title" },
        "severity": { "$ref": "#/$defs/severity" },
        "exceptionable": { "type": "boolean" },
        "remediationHint": { "$ref": "#/$defs/remediationHint" }
      }
    }
  }
}
